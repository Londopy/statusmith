{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Statusmith",
  "version": "0.1.0",
  "identifier": "com.londopy.statusmith",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Statusmith",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
